#!/bin/bash
# bin/dev - base PostgreSQL + une collecte de test (5 flux)
# Sur un serveur ou Podman tourne en root : sudo bin/dev
set -euo pipefail
cd "$(dirname "$0")/.."

if command -v podman-compose >/dev/null; then
    COMPOSE="podman-compose"
elif command -v docker >/dev/null; then
    COMPOSE="docker compose"
else
    echo "Ni podman-compose ni docker trouves." >&2
    exit 1
fi

if [ ! -f .env ]; then
    cp .env.example .env
    echo ".env cree depuis .env.example : changez le mot de passe."
fi
mkdir -p data

$COMPOSE build
$COMPOSE up -d db
$COMPOSE run --rm collector
echo "Purge (J+7) : $COMPOSE run --rm purge"
