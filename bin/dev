#!/bin/bash
# bin/dev - Lance le projet M2Ops en deux commandes
# Cette script initialise l'environnement de développement

set -e

echo "=== Lancement de l'environnement de développement M2Ops ==="

# 1. Vérifier que Docker/Podman est disponible
if command -v podman &>/dev/null; then
    CONTAINER_ENGINE="podman"
elif command -v docker &>/dev/null; then
    CONTAINER_ENGINE="docker"
else
    echo "❌ Ni Podman ni Docker trouvés. Installez-en un."
    exit 1
fi

# 2. Construire et démarrer les conteneurs
echo "Construction des conteneurs avec $CONTAINER_ENGINE..."
$CONTAINER_ENGINE compose up --build -d

echo "✅ Environnement de développement prêt !"
echo "   - L'app est accessible via les ports définis dans docker-compose.yml"
echo "   - PostgreSQL est prêt à recevoir les connexions"
echo "   - Pour voir les logs : $CONTAINER_ENGINE compose logs -f"