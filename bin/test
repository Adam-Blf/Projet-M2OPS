#!/bin/bash
# bin/test - lint + tests unitaires (sans reseau ni base)
set -euo pipefail
cd "$(dirname "$0")/.."

if command -v uv >/dev/null; then
    uv venv -q --allow-existing .venv
    uv pip install -q --python .venv -r requirements-dev.txt
else
    [ -d .venv ] || python3 -m venv .venv
    .venv/bin/pip install -q -r requirements-dev.txt
fi

.venv/bin/ruff check .
.venv/bin/flake8 src/ tests/ --max-line-length=100
.venv/bin/pytest -v
